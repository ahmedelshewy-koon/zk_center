HOST=127.0.0.1
PORT=5180
DATABASE_URL=postgresql://zk_central_app:CHANGE_ME@127.0.0.1:5432/zk_central
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Console sign-in (optional). Off while unset, shorter than 12 characters or left as the placeholder;
# the admin token above always works. Sign-in gives the browser a session token (30 min idle,
# 12 h maximum), never ADMIN_TOKEN. Generate a password with: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# The device is ONLY read from when you explicitly trigger the import API
EGYPT_ZK_IP=192.168.1.147
EGYPT_ZK_PORT=4370
# Send to Device: the preview reads a terminal's user list only when this is exactly true;
# otherwise it checks ZK Central records alone and never connects. Pushes need it too.
ENABLE_DEVICE_READS=false
# Other terminals the console may connect to (reads for previews), as ip:port,ip:port.
# The Egypt address above is always approved. Leave empty until each address is reviewed.
DEVICE_APPROVED_ADDRESSES=
# "Send to device" (employee identity only: user ID + name; never fingerprint templates) is
# preview-only unless this is exactly true. Enable only after an approved hardware test.
ENABLE_DEVICE_WRITES=false
# No biometric templates or external HR dispatch in this release
